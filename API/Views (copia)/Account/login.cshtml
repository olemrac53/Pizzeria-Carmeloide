@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model PizzeriaBackend.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
    var erroresGenerales = ViewData.ModelState.TryGetValue(string.Empty, out var entrada) ? entrada.Errors : null;
}

@section Styles {
    <partial name="_AuthEstilos" />
}

<div class="auth-pagina">
    <div class="auth-card">

        <!-- Lado rojo decorativo -->
        <div class="auth-lado">
            <span class="auth-pizza p1" style="--foto:url('/images/pepperoni.png')"></span>
            <span class="auth-pizza p2" style="--foto:url('/images/caprese.png')"></span>
            <span class="auth-pizza p3" style="--foto:url('/images/napolitana.png')"></span>

            <h2 class="marca">Amore a<br />prima pizza</h2>
            <p>Iniciá sesión y pedí tu pizza favorita en un minuto.</p>
        </div>

        <!-- Formulario -->
        <div class="auth-form">
            <div>
                <span class="auth-icono">🍕</span>
                <h1>Bienvenido de nuevo</h1>
                <p class="sub">Ingresá a tu cuenta de Pizzería</p>
            </div>

            @if (erroresGenerales != null && erroresGenerales.Count > 0)
            {
                <div class="alert alert-danger py-2 small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @erroresGenerales[0].ErrorMessage
                </div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(ViewData["ReturnUrl"]?.ToString())" method="post">

                <div class="campo">
                    <div class="form-floating">
                        <input asp-for="Usuario" class="form-control" placeholder="Usuario" autocomplete="username" autofocus required />
                        <label for="Usuario"><i class="bi bi-person me-1"></i> Usuario</label>
                    </div>
                    <span asp-validation-for="Usuario" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="campo">
                    <div class="form-floating">
                        <input asp-for="Clave" class="form-control pe-5" placeholder="Contraseña" autocomplete="current-password" required />
                        <label for="Clave"><i class="bi bi-lock me-1"></i> Contraseña</label>
                    </div>
                    <button type="button" class="ojo" onclick="verClave('Clave', this)" aria-label="Mostrar u ocultar contraseña">
                        <i class="bi bi-eye"></i>
                    </button>
                    <span asp-validation-for="Clave" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label class="form-check-label small text-muted" for="Recordarme">Mantener la sesión iniciada</label>
                </div>

                <button type="submit" class="btn-pizza">Iniciar sesión</button>
            </form>

            <div class="pie">
                ¿No tenés cuenta?
                <a asp-controller="Account" asp-action="Registro">Registrate acá</a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    function verClave(id, boton) {
        const input = document.getElementById(id);
        const mostrar = input.type === 'password';
        input.type = mostrar ? 'text' : 'password';
        boton.querySelector('i').className = mostrar ? 'bi bi-eye-slash' : 'bi bi-eye';
    }
</script>
}
