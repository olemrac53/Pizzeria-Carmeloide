@section Styles {
  <style>
    #resultado {
      margin-top: 20px;
      white-space: pre-wrap;
      border: 1px solid #ccc;
      padding: 10px;
    }
  </style>
}

  <div class="container py-4" style="max-width: 480px;">

    <img src="https://img.magnific.com/fotos-premium/pizza-italiana-lista-verduras-frescas-sobre-fondo-madera_736061-566.jpg?semt=ais_hybrid&w=740&q=80"
         class="img-fluid rounded mb-4" alt="Imagen de una pizza">

    <h2 class="mb-4">Hacer un pedido</h2>

    <div class="mb-3">
      <label for="nombre" class="form-label">Nombre del cliente</label>
      <input type="text" id="nombre" class="form-control" value="Estudiante ET12">
    </div>

    <div class="mb-3">
      <label for="direccion" class="form-label">Dirección</label>
      <input type="text" id="direccion" class="form-control" value="Av. Siempre Viva 126">
    </div>

    <div class="mb-3">
      <label for="variedad" class="form-label">Variedad de pizza</label>
      <input type="text" id="variedad" class="form-control" value="Muzzarella Grande">
    </div>

    <div class="mb-3">
      <label for="precio" class="form-label">Precio</label>
      <input type="number" id="precio" class="form-control" value="8500" step="0.01" min="0.01">
    </div>

    <div class="mb-3">
      <label for="cantidad" class="form-label">Cantidad</label>
      <input type="number" id="cantidad" class="form-control" value="1" min="1">
    </div>

    <button id="btnPedir" class="btn btn-danger w-100">Hacer pedido</button>

    <div id="resultado"></div>

  </div>

@section Scripts {
  <script>

    const URL_API = "http://localhost:5180/pedidos";


    document.getElementById("btnPedir").addEventListener("click", hacerPedido);

    async function hacerPedido() {
      const resultadoDiv = document.getElementById("resultado");
      resultadoDiv.textContent = "Enviando pedido...";

    
      const pedido = {
        ClienteNombre: document.getElementById("nombre").value,
        ClienteDireccion: document.getElementById("direccion").value,
        PizzaVariedad: document.getElementById("variedad").value,
        PizzaPrecio: parseFloat(document.getElementById("precio").value),
        Cantidad: parseInt(document.getElementById("cantidad").value, 10)
      };

      try {
       
        const respuesta = await fetch(URL_API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(pedido)
        });

       
        const texto = await respuesta.text();

        if (respuesta.ok) {
          resultadoDiv.textContent = "¡Pedido recibido!\n" + texto;
        } else {
          resultadoDiv.textContent = "El servidor rechazó el pedido (" + respuesta.status + ")\n" + texto;
        }
      } catch (error) {
     
        resultadoDiv.textContent = "Error de red: no se pudo contactar a la API.\n" + error.message;
      }
    }
  </script>
}