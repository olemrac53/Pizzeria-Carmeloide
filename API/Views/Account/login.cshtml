@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout"; // Asegura que use tu plantilla general si la tiene
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="width: 100%; max-width: 420px; background-color: #ffffff;">
        
        <div class="text-center mb-4">
            <div class="bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px; font-size: 24px;">
                🍕
            </div>
            <h3 class="fw-bold text-dark">Bienvenido de nuevo</h3>
            <p class="text-muted small">Ingresá a tu cuenta de Pizzería</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 small" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="form-floating mb-3">
                <input type="text" class="form-control rounded-3" id="usuario" name="usuario" placeholder="Nombre de usuario" required autofocus>
                <label for="usuario" class="text-muted"><i class="bi bi-person me-1"></i> Usuario</label>
            </div>

            <div class="form-floating mb-4">
                <input type="password" class="form-control rounded-3" id="clave" name="clave" placeholder="Contraseña" required>
                <label for="clave" class="text-muted"><i class="bi bi-lock me-1"></i> Contraseña</label>
            </div>

            <button type="submit" class="btn btn-danger w-100 py-3 rounded-3 fw-bold shadow-sm transition-all" style="font-size: 1rem;">
                Iniciar Sesión
            </button>
        </form>

        <div class="text-center mt-4">
            <p class="text-muted small mb-0">¿No tenés cuenta? <a asp-controller="Account" asp-action="Registro" class="text-danger text-decoration-none fw-bold">Registrate acá</a></p>
        </div>

    </div>
</div>

<!-- Estilos opcionales para transiciones suaves -->
<style>
    body {
        background-color: #f8f9fa;
    }
    .form-control:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.15);
    }
    .btn-danger:hover {
        background-color: #bb2d3b;
        transform: translateY(-1px);
    }
</style>