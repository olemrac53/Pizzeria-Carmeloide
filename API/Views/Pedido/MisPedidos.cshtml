@model List<PizzeriaBackend.Models.Pedido>

@{
    ViewData["Title"] = "Mis Pedidos";
}

<div class="container mt-4" style="max-width: 800px;">
    <h3 class="mb-4">Mis pedidos</h3>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Todavía no hiciste ningún pedido.</div>
    }

    @foreach (var pedido in Model)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Pedido #@pedido.Id</strong>
                <span class="text-muted small">@pedido.Momento.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="card-body text-start">
                <ul class="mb-2">
                    @foreach (var d in pedido.Detalles)
                    {
                        <li>@d.Cantidad x @d.Pizza.Variedad ($@d.Pizza.Precio c/u)</li>
                    }
                </ul>
                <span class="badge bg-warning text-dark fs-6">@pedido.Estado</span>
            </div>
        </div>
    }
</div>