@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model PizzeriaBackend.Models.PedidoDTO

@{
    ViewData["Title"] = "Pedir Pizza";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"> Realizar Pedido de Pizza</h4>
        </div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                </div>
            }

            <form asp-action="Agregar" asp-controller="Pedido" method="post" id="formPedido">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Nombre del Cliente</label>
                    <input type="text" name="ClienteNombre" class="form-control" placeholder="Ej: Juan Pérez" required />
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Dirección de Entrega</label>
                    <input type="text" name="ClienteDireccion" class="form-control" placeholder="Ej: Av. Rivadavia 1234" required />
                </div>

                @{
                    var pizzasMenu = ViewBag.Pizzas as List<PizzeriaBackend.Models.Pizza>
                                      ?? new List<PizzeriaBackend.Models.Pizza>();
                }

                @if (!pizzasMenu.Any())
                {
                    <div class="alert alert-warning">
                        Todavía no hay pizzas cargadas en el menú. Agregá alguna en la tabla
                        <code>Pizzas</code> de la base de datos para poder hacer un pedido.
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Variedad de Pizza</label>
                    <select id="selectPizza" name="PizzaVariedad" class="form-select" required
                            onchange="actualizarPrecio()" disabled="@(!pizzasMenu.Any())">
                        @foreach (var pizza in pizzasMenu)
                        {
                            <option value="@pizza.Variedad" data-precio="@pizza.Precio.ToString("0.00")">
                                @pizza.Variedad - $@pizza.Precio.ToString("N0")
                            </option>
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-bold">Cantidad</label>
                        <input type="number" name="Cantidad" class="form-control" value="1" min="1" max="20" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label font-weight-bold">Precio Unitario ($)</label>
                        <input type="number" step="0.01" id="inputPrecio" name="PizzaPrecio" class="form-control bg-light"
                               value="@(pizzasMenu.Any() ? pizzasMenu.First().Precio.ToString("0.00") : "0")" readonly required />
                    </div>
                </div>

                <div class="d-grid gap-2 mt-3">
                    <button type="submit" class="btn btn-danger btn-lg" disabled="@(!pizzasMenu.Any())">
                        Enviar Pedido a Cocina
                    </button>
                    <a href="/" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function actualizarPrecio() {
        const select = document.getElementById("selectPizza");
        const opcionSeleccionada = select.options[select.selectedIndex];
        const precio = opcionSeleccionada.getAttribute("data-precio");
        document.getElementById("inputPrecio").value = precio;
    }
</script>
}