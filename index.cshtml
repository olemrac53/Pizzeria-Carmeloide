<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Pizzeria - Hacer Pedido</title>
  <img src="https://img.magnific.com/fotos-premium/pizza-italiana-lista-verduras-frescas-sobre-fondo-madera_736061-566.jpg?semt=ais_hybrid&w=740&q=80" alt="Imagen borrosa de una pizza">

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 420px;
      margin: 40px auto;
    }
    label {
      display: block;
      margin-top: 10px;
    }
    input {
      width: 100%;
      padding: 6px;
      box-sizing: border-box;
    }
    button {
      margin-top: 15px;
      padding: 8px 16px;
    }
    #resultado {
      margin-top: 20px;
      white-space: pre-wrap;
      border: 1px solid #ccc;
      padding: 10px;
    }
  </style>
</head>
<body>

  <h2>Hacer un pedido</h2>

  <label for="nombre">Nombre del cliente</label>
  <input type="text" id="nombre" value="Estudiante ET12">

  <label for="direccion">Dirección</label>
  <input type="text" id="direccion" value="Av. Siempre Viva 123">

  <label for="variedad">Variedad de pizza</label>
  <input type="text" id="variedad" value="Muzzarella Grande">

  <label for="precio">Precio</label>
  <input type="number" id="precio" value="8500" step="0.01" min="0.01">

  <label for="cantidad">Cantidad</label>
  <input type="number" id="cantidad" value="1" min="1">

  <button id="btnPedir">Hacer pedido</button>

  <div id="resultado"></div>

  <script>

    const URL_API = "http://localhost:5000/pedidos";


    document.getElementById("btnPedir").addEventListener("click", hacerPedido);

    async function hacerPedido() {
      const resultadoDiv = document.getElementById("resultado");
      resultadoDiv.textContent = "Enviando pedido...";

    
      const pedido = {
        ClienteNombre: document.getElementById("nombre").value,
        ClienteDireccion: document.getElementById("direccion").value,
        PizzaVariedad: document.getElementById("variedad").value,
        PizzaPrecio: parseFloat(document.getElementById("precio").value),
        Cantidad: parseInt(document.getElementById("cantidad").value, 10)
      };

      try {
       
        const respuesta = await fetch(URL_API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(pedido)
        });

       
        const texto = await respuesta.text();

        if (respuesta.ok) {
          resultadoDiv.textContent = "¡Pedido recibido!\n" + texto;
        } else {
          resultadoDiv.textContent = "El servidor rechazó el pedido (" + respuesta.status + ")\n" + texto;
        }
      } catch (error) {
     
        resultadoDiv.textContent = "Error de red: no se pudo contactar a la API.\n" + error.message;
      }
    }
  </script>

</body>
</html>
